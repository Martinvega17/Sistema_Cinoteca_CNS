# Cadena de conexión de tu base de datos Postgres (Neon → Connection Details).
# Debe incluir sslmode=require. Ejemplo:
# postgresql://usuario:password@ep-xxxx.us-east-2.aws.neon.tech/cinoteca?sslmode=require
DATABASE_URL=

# Secreto para firmar las sesiones (JWT). Genera uno único y largo, por
# ejemplo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Agrega estas mismas dos variables en Vercel:
# Project → Settings → Environment Variables

{
  "name": "sistema-cinoteca-cns",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Bitácora de acceso a la Cinoteca del CNS · IPICYT — con backend en Postgres/Neon",
  "scripts": {
    "build": "npm run build:css && npm run db:migrate && cp index.html dist/",
    "build:css": "node ./node_modules/tailwindcss/lib/cli.js -i ./src/css/input.css -o ./css/output.css --minify",
    "watch:css": "node ./node_modules/tailwindcss/lib/cli.js -i ./src/css/input.css -o ./dist/css/output.css --watch",
    "dev": "node scripts/dev-server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:create-admin": "node ./js/scripts/create-admin.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "bcryptjs": "^2.4.3",
    "cookie": "^0.6.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "pg": "^8.23.0",
    "tailwindcss": "^3.4.19"
  }
}
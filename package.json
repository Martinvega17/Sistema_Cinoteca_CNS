{
  "name": "ipicyt-bitacora-boveda",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bitácora de acceso digital a la bóveda de resguardo del IPICYT",
  "scripts": {
    "build:css": "tailwindcss -i ./src/css/input.css -o ./dist/css/output.css --minify",
    "watch:css": "tailwindcss -i ./src/css/input.css -o ./dist/css/output.css --watch",
    "serve": "npx serve . -l 5500"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  }
}
